{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"typeRoots": ["../../../../../tooling/node_modules/@types"]
	},
	"include": ["**/*.ts"],
	"exclude": ["mcp-tools.ts", "index.ts", "test/**"]
}
